+    /** A line of the world's news to every ruled court still standing that knows each of [about], save [except] */
+    private fun tellCourts(text: String, about: List<Civilization>, except: List<Civilization> = emptyList()) {
+        for (name in orders.keys) {
+            val court = game().civilizations.firstOrNull { it.civName == name }?.takeIf { it.isAlive() } ?: continue
+            if (court in except || about.any { it != court && !court.knows(it) }) continue
+            log(court, text)
+        }
+    }
+
+    /** The turn's news the engine tells poorly or not at all (RulerOverrides.News), to the world once and to the courts in our words: projects, faiths, pacts, denouncements */
+    private fun tellNews() {
+        val name = { c: Civilization -> c.civName }
+        for (project in turnNews.filterIsInstance<RulerOverrides.News.Project>()) {
+            val building = project.project
+            if (building.isWonder) continue // a world wonder is told as one (the wonder's event, the United Nations' own line)
+            val opens = when {
+                building.hasUnique(com.unciv.models.ruleset.unique.UniqueType.EnablesNuclearWeapons) -> "the age of atomic arms begins"
+                building.hasUnique(com.unciv.models.ruleset.unique.UniqueType.EnablesConstructionOfSpaceshipParts) -> "its race for the stars begins"
+                building.hasUnique(com.unciv.models.ruleset.unique.UniqueType.TriggersCulturalVictory) -> "its completion wins the world by culture"
+                else -> null
+            }
+            // Every power raises its own Apollo Program: Run 36's courts read another's as the one of the world (Siam's own as news, the Iroquois' as void)
+            val own = building.hasUnique(com.unciv.models.ruleset.unique.UniqueType.EnablesConstructionOfSpaceshipParts)
+            val what = "${if (project.begun) "began" else "completed"} ${if (own) "its own" else "the"} ${building.name}"
+            addPublicEvent("${name(project.civ)} $what in ${project.city.name}" + (opens?.let { ": $it" } ?: "") + ".")
+            for (court in orders.keys.mapNotNull { n -> game().civilizations.firstOrNull { it.civName == n && it.isAlive() } }) {
+                if (court == project.civ) continue // its own line says it was built
+                log(court, (if (court.knows(project.civ)) "${name(project.civ)} $what in ${project.city.name}" else "A people we have not met $what") + (opens?.let { ": $it" } ?: "") + ".")
+            }
+        }
+        for (faith in turnNews.filterIsInstance<RulerOverrides.News.Faith>()) {
+            val beliefs = faith.beliefs.map { it.name }.takeIf { it.isNotEmpty() }?.let { " with the belief${plural(it.size)} ${andList(it)}" } ?: ""
+            val text = if (faith.enhanced) "${name(faith.civ)} enhanced ${faith.religion}$beliefs."
+                else "${name(faith.civ)} founded ${faith.religion}" + (faith.holyCity?.let { " in its holy city ${it.name}" } ?: "") + "$beliefs."
+            addPublicEvent(text)
+            tellCourts(text, listOf(faith.civ), except = listOf(faith.civ)) // a court's own faith is told by its beliefs' line
+        }
+        // A pact's two sides each tell its end; signed and ended in one turn is a renewal
+        // Keyed by name: a map keyed by the engine's own objects draws on their identity hashes, and so shifts the order the engine's own sets are walked in
+        val pacts = LinkedHashMap<Pair<String, String>, MutableSet<String>>()
+        val byName = HashMap<String, Civilization>()
+        for (pact in turnNews.filterIsInstance<RulerOverrides.News.Pact>()) {
+            byName[pact.a.civName] = pact.a; byName[pact.b.civName] = pact.b
+            val pair = if (pact.how == "broken") pact.a.civName to pact.b.civName else listOf(pact.a.civName, pact.b.civName).sorted().let { it[0] to it[1] }
+            pacts.getOrPut(pair) { LinkedHashSet() } += pact.how
+        }
+        for ((pair, hows) in pacts) {
+            val (a, b) = byName[pair.first]!! to byName[pair.second]!!
+            val text = when {
+                "broken" in hows -> "${name(a)} went to war and so ended its Defensive Pact with ${name(b)}."
+                "signed" in hows && "lapsed" in hows -> "${name(a)} and ${name(b)} renewed their Defensive Pact."
+                "signed" in hows -> "${name(a)} and ${name(b)} signed a Defensive Pact."
+                else -> "The Defensive Pact between ${name(a)} and ${name(b)} ran its term and ended."
+            }
+            addPublicEvent(text)
+            tellCourts(text, listOf(a, b), except = listOf(a, b)) // the two sides have their deals' line, and the declarer its order's
+            if ("broken" in hows && b.civName in orders) log(b, "${name(a)} went to war and so ended its Defensive Pact with us.")
+        }
+        for (denounced in turnNews.filterIsInstance<RulerOverrides.News.Denounced>()) {
+            val text = "${name(denounced.by)} denounced ${name(denounced.whom)}."
+            addPublicEvent(text)
+            tellCourts(text, listOf(denounced.by, denounced.whom), except = listOf(denounced.by, denounced.whom))
+            if (denounced.whom.civName in orders) log(denounced.whom, "${name(denounced.by)} has denounced us.")
+        }
+    }
+
+    /** Log lines an advisor would want to see at once, not at the next scheduled look-in */
+    // Not answers to our own proposals: acting on one sends another, and the advisor would be woken by his own echo every turn.
+    // Not "demands": that is a city asking for a luxury, not a neighbour asking for tribute.
+    // Not our own order's echo ("By your order: we declared war"), and not a barbarian camp cleared ("We have captured a barbarian encampment").
+    private val wakeWorthy = listOf("dropped .* because", "(?<!By your order: we )declared war", "joined .* in the war against us", "has denounced us", "lost in action",
+        // A city-state's alliance lost: its vote and its goods go with it (the Inca lost Geneva at T281 and slept through the vote, Run 20). Churn within a turn is filtered before it is logged
+        "lost our alliance",
+        // The alerts every realm gets (the Utopia Project begun or finished): the end of the game may be in sight
+        "has started constructing", "has completed [^.]*!$",
+        "awaits orders", "The United Nations now stands", "our vote is not pledged", "(?<!We have )captured(?! a barbarian)", "has been destroyed", "is no more", "has been stuck", "offers peace", "\\(an advised court\\) offers a deal", "demands that we", "proposes a Declaration of Friendship",
+        // the notifications pass: a revolt, a war joined by our pact, a project that changes the race, a pact ended by war
+        "rose in revolt", "^We joined .* in the war against", "(began|completed) (the|its own) .+: (the age of atomic arms begins|its race for the stars begins|its completion wins the world)", "ended its Defensive Pact with us").map { Regex(it, RegexOption.IGNORE_CASE) }
+
+    private val warningsWoken = HashMap<String, HashSet<String>>()
+    /** The world as the last advance left it (null before the first) */
+    private var worldAtLastAdvance: WorldSnapshot? = null
+    /** A war as the engine declared it (RulerOverrides.warDeclared), names only, kept since the last advance: the world's events and the council's news are
+     *  built from these, so a pact partner's or a city-state's join is never told as a declaration, and the council is framed for the declarer as their
+     *  own doing and for a partner pulled in as its pact's (audit 2026-10-03) */
+    private class WarRecord(val declarer: String, val target: String, val type: WarType, val ally: String?) {
+        val joins get() = type == WarType.DefensivePactWar || type == WarType.CityStateAllianceWar
+        val byPact get() = type == WarType.DefensivePactWar
+        fun covers(first: String, second: String) = setOf(declarer, target) == setOf(first, second)
+        /** Is this join part of [war]: its ally's war against its target, on either side of it */
+        fun joined(war: WarRecord) = joins && ally != null && (war.declarer == ally && war.target == target || war.target == ally && war.declarer == target)
+        override fun toString() = "$declarer>$target>$type>${ally ?: ""}"
+        companion object { fun parse(text: String) = text.split(">").let { WarRecord(it[0], it[1], WarType.valueOf(it[2]), it.getOrNull(3)?.ifEmpty { null }) } }
+    }
+    private val warsDeclared = ArrayList<WarRecord>()
+
+    /** The world's one line for a war as it was declared */
+    private fun told(war: WarRecord) = when (war.type) {
+        WarType.DirectWar -> "${war.declarer} declared war on ${war.target}."
+        WarType.DefensivePactWar -> "${war.declarer} came in at ${war.ally}'s side by its pact, against ${war.target}."
+        WarType.CityStateAllianceWar -> "${war.declarer}, ${war.ally}'s ally, joined the war against ${war.target}."
+        WarType.JoinWar -> "${war.declarer} declared war on ${war.target}, called in by ${war.ally}."
+        WarType.TeamWar -> "${war.declarer} declared war on ${war.target}, together with ${war.ally}."
+        WarType.ProtectedCityStateWar -> "${war.declarer} declared war on ${war.target} for ${war.ally}, the city-state under its protection."
+        WarType.AlliedCityStateWar -> "${war.declarer} declared war on ${war.target} for its ally ${war.ally}."
+    }
+
+    /** Every war the engine declares, whoever's, as it is declared: recorded for the council, and written into the world's events at once */
+    private fun noteWar(war: RulerOverrides.War) {
+        if (war.declarer.isBarbarian || war.target.isBarbarian) return
+        val record = WarRecord(war.declarer.civName, war.target.civName, war.type, war.ally?.civName)
+        warsDeclared += record
+        // A power's city-state allies join one by one as the engine calls them in; the world's history has them in one line, not one per city
+        val last = publicEvents.lastOrNull()?.takeIf { it["turn"] == stamp() }
+        val company = last?.let { Regex("^(.+), ${Regex.escape(record.ally ?: "")}'s all(?:y|ies), joined the war against ${Regex.escape(record.target)}\\.$").find(it["text"] as String) }
+        if (record.type == WarType.CityStateAllianceWar && company != null) {
+            val names = company.groupValues[1].replace(" and ", ", ").split(", ") + record.declarer
+            publicEvents[publicEvents.size - 1] = last + ("text" to "${andList(names)}, ${record.ally}'s allies, joined the war against ${record.target}.")
+        } else addPublicEvent(told(record))
+    }
