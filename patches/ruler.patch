+    }
+    @Volatile var nuked: ((NukeFall) -> Unit)? = null
+    /** Told of every detonation: the world hears of each, the courts it touched in full */
+    fun noteNuke(fall: NukeFall) {
+        nuked?.invoke(fall)
+    }
+}
