+                "uniqueUnits" to ruleset.units.values.filter { it.uniqueTo == n.name }.map { u -> u.name + (u.replaces?.let { " (in place of the $it)" } ?: "") },
+                "uniqueBuildings" to ruleset.buildings.values.filter { it.uniqueTo == n.name }.map { b -> b.name + (b.replaces?.let { " (in place of the $it)" } ?: "") },
+                "uniqueImprovements" to ruleset.tileImprovements.values.filter { it.uniqueTo == n.name }.map { it.name }.ifEmpty { null })
+        }
+        // A city-state kind, or a city-state by name (its kind)
+        (find(ruleset.cityStateTypes) ?: civ.gameInfo.civilizations.firstOrNull { it.isCityState && it.civName.equals(name, ignoreCase = true) }?.cityStateType)?.let { k ->
+            return mapOf("kind" to "city-state kind", "name" to k.name,
+                "toAFriend" to words(k.friendBonusUniques), "toItsAlly" to words(k.allyBonusUniques),
+                "note" to "a city-state is a friend at 30 influence and allied at 60 with the most influence of anyone; an ally also gets its luxuries and strategic resources, and its vote when the world votes")
+        }
+        throw ApiError(404, "The rulebook has nothing called '$name'. look_up knows buildings and wonders, units, technologies, policies, beliefs, treaties, tile improvements (great improvements too), resources, terrain and natural wonders, promotions, peoples (by name: their ability and unique units and buildings) and city-state kinds (or a city-state by name)")
+    }
+
+    /** The treaties a deal can carry, as the rulebook would explain them: what each binds, what it costs, how long it runs, what it needs */
+    private fun treaty(civ: Civilization, name: String): Map<String, Any?>? {
+        val length = civ.gameInfo.speed.dealDuration
+        val raCost = (civ.getEra().researchAgreementCost * civ.gameInfo.speed.goldCostModifier).toInt()
+        return when (name.trim().lowercase().removeSuffix("s")) {
+            "defensive pact" -> mapOf("kind" to "treaty", "name" to Constants.defensivePact, "length" to "$length turns",
+                "binds" to "If a third power declares war on either side, the other is pulled into that war at once, automatically. Declaring war yourself cancels your own defensive pacts - they do not drag a partner into a war we start.",
+                "gold" to "none", "needs" to "a Declaration of Friendship in force between the two, shared embassies where the game asks for them, and the learning that allows pacts on both sides")
+            "research agreement" -> mapOf("kind" to "treaty", "name" to Constants.researchAgreement, "length" to "$length turns",
+                "binds" to "Both sides pay the gold up front; when it runs out each gains research, more the more both learnt meanwhile. A war between the two cancels it, and the gold is lost.",
+                "gold" to "$raCost gold from each side at our age (the dearer of the two sides' ages sets it)",
+                "needs" to "a Declaration of Friendship in force, shared embassies where the game asks for them, the learning that allows it on both sides, the gold on both sides, techs still left to learn on both sides, and no research agreement already running between the two")
+            "open border" -> mapOf("kind" to "treaty", "name" to Constants.openBorders, "length" to "$length turns",
+                "binds" to "Each side's units may cross the other's lands; without it they are turned back at the border. It is usually a swap - each side gives its own.",
+                "gold" to "none", "needs" to "peace, and the learning that allows it")
+            "declaration of friendship" -> mapOf("kind" to "treaty", "name" to "Declaration of Friendship",
+                "binds" to "A public friendship: it raises regard on both sides and is the door to defensive pacts and research agreements. Denouncing or attacking a friend is remembered as betrayal by them and by others.",
+                "gold" to "none", "needs" to "peace and goodwill; it is proposed with the friendship order and answered on the other side's turn")
+            else -> null
+        }
+    }
+
+    /** [audience]: asked at a ruler's audience, where the ruler's own word is the war leave - calls to war are among what we can offer then */
+    private fun options(civ: Civilization, audience: Boolean = false): Map<String, Any?> {
+        val leave = audience || orders[civ.civName]?.mayDeclareWar == true
+        ensureStanding(civ)
+        val ruleset = civ.gameInfo.ruleset
+        return mapOf(
+            "warEstimate" to warEstimate(civ, everyPower = true),
+            "researchableNow" to ruleset.technologies.values.filter { civ.tech.canBeResearched(it.name) }
+                .map { mapOf("tech" to it.name, "turns" to civ.tech.turnsToTech(it.name)) },
+            "researchGoals" to "Any technology name works as a research goal; the path to it is researched automatically.",
+            "futureTechs" to ruleset.technologies.values.filter { !civ.tech.isResearched(it.name) }.map { it.name },
+            "policyBranches" to ruleset.policyBranches.values.map {
+                mapOf("branch" to it.name, "era" to it.era,
+                    "adopted" to civ.policies.isAdopted(it.name),
+                    "complete" to civ.policies.isAdopted("${it.name} Complete"))
+            },
+            "personality" to mapOf(
+                "current" to RulerOverrides.personalities[civ.civID]?.let { p -> PersonalityValue.entries.associate { it.name to p[it] } },
+                "meaning" to mapOf(
+                    "Production/Food/Gold/Science/Culture/Happiness/Faith" to "how much cities favour buildings and tiles that yield that stat when the officials choose",
+                    "Faith (also)" to "the share of the faith above your faithReserve that the officials spend on their own: 5 or more, all of it; below 5, that many fifths; 0, none - the faith then lies for you, and religion.faithBuysNow says what it could buy",
+                    "Military" to "how large an army the officials keep and how often cities train units on their own",
+                    "Aggressive" to "whether soldiers push out to attack or stay home and defend",
+                    "Expansion" to "how eagerly cities train settlers on their own; 10 means settlers whenever affordable",
+                    "Commerce" to "willingness to trade luxuries and make deals",
+                    "Diplomacy" to "effort spent on city-states and friendships - and whether the officials court city-states with gold at all: 0, never (they never pay for an alliance another power holds beyond one gift's reach)",
+                    "Loyal" to "how much they honour friendships",
+                    "DeclareWar" to "how warlike their building and keeping is (the Great Wall, a standing army); they never declare war on their own - war is the ruler's")),
+            "diplomacy" to diplomacy.tradeOptions(civ, leave),
+            // What each city can build, with turns and its price in gold - and in faith where faith buys it (a Missionary is bought, never built)
+            "buildable" to civ.cities.associate { city ->
+                city.name to (ruleset.buildings.values.asSequence() + ruleset.units.values.asSequence())
+                    .mapNotNull { construction -> Triple(construction, construction.isBuildable(city.cityConstructions), faithPrice(city, construction)).takeIf { it.second || it.third != null } }
+                    .map { (construction, buildable, faith) ->
+                        val buy = construction.getStatBuyCost(city, Stat.Gold)?.takeIf { buildable && construction.canBePurchasedWithStat(city, Stat.Gold) }
+                        "${construction.name} (" + listOfNotNull(if (buildable) "${city.cityConstructions.turnsToConstruction(construction.name)}t" else null, buy?.let { "buy $it gold" }, faith?.let { "buy $it faith" },
+                            (construction as? com.unciv.models.ruleset.Building)?.happiness?.toInt()?.takeIf { it > 0 }?.let { "+$it mood" }).joinToString(", ") + ")"
+                    }.toList()
+            },
+            "gold" to civ.gold,
+            "canDeclareWarOn" to civ.getKnownCivs()
+                .filter { it.isAlive() && !it.isBarbarian && !civ.isAtWarWith(it) && civ.getDiplomacyManager(it)!!.canDeclareWar() }
+                .map { it.civName }.toList()
+        )
+    }
+
+    //endregion
+}
diff --git a/desktop/src/com/unciv/app/desktop/ruler/RulerTrail.kt b/desktop/src/com/unciv/app/desktop/ruler/RulerTrail.kt
new file mode 100644
index 0000000..6dccfc1
--- /dev/null
+++ b/desktop/src/com/unciv/app/desktop/ruler/RulerTrail.kt
@@ -0,0 +1,111 @@
+package com.unciv.app.desktop.ruler
+
+import com.badlogic.gdx.utils.JsonValue
+import com.unciv.logic.GameInfo
+import java.util.TreeMap
+
+/**
+ *  Where every unit stood at the end of each recent turn, and where units fell and cities changed hands -
+ *  so the map can show an age's marches instead of a still picture.
+ */
+class RulerTrail {
+    class Stand(val x: Int, val y: Int, val civ: String, val military: Boolean, val name: String = "")
+    /** kind: "fallen" (a military unit lost; civ is whose, id the unit's) or "taken" (a city changed hands; civ is the new owner) */
+    class Mark(val turn: Int, val x: Int, val y: Int, val kind: String, val civ: String, val id: Int = -1)
+
+    /** turn -> unit id -> where it stood */
+    val stands = TreeMap<Int, HashMap<Int, Stand>>()
+    /** Units the battle hook reported killed or captured since the last record, by id, as they stood where they fell: only these are marked fallen - a disbanded
+     *  or used-up unit is no loss in the field. The hook's tile, not the last stand's: a company that marched and fell in one turn fell at the end of its march */
+    val lostInBattle = HashMap<Int, Stand>()
+    val marks = ArrayList<Mark>()
+    /** "x,y" -> owner, as of the last recorded turn */
+    private var cityOwners = HashMap<String, String>()
+    /** turn -> civ -> tiles (by index in the tile list) that civ saw for the first time that turn - the growth of each known world */
+    val seen = TreeMap<Int, HashMap<String, IntArray>>()
+    /** turn -> civ -> peoples met that turn */
+    val met = TreeMap<Int, HashMap<String, List<String>>>()
+    /** What each civ had explored and whom it knew at the last record: in memory only, so a restart starts the reckoning afresh without a false flood of "new" */
+    private val explored = HashMap<String, java.util.BitSet>()
+    private val known = HashMap<String, Set<String>>()
+
+    /** Call once a game is loaded and after every turn */
+    fun record(game: GameInfo) {
+        val now = HashMap<Int, Stand>()
+        for (civ in game.civilizations) for (unit in civ.units.getCivUnits()) {
+            val p = unit.getTile().position
+            now[unit.id] = Stand(p.x, p.y, civ.civName, unit.isMilitary(), unit.name)
+        }
+        val owners = HashMap<String, String>()
+        for (civ in game.civilizations) for (city in civ.cities) city.getCenterTile().position.let { owners["${it.x},${it.y}"] = civ.civName }
+
+        // An upgrade retires the old unit and raises a new one on the same spot: not a loss, and the battle hook never names it
+        for ((id, fall) in lostInBattle) if (id !in now && fall.military) marks += Mark(game.turns, fall.x, fall.y, "fallen", fall.civ, id)
+        val before = stands.lowerEntry(game.turns)?.takeIf { it.key == game.turns - 1 }?.value
+        if (before != null) {
+            for ((where, owner) in owners) {
+                val previous = cityOwners[where] ?: continue
+                if (previous != owner) where.split(",").let { marks += Mark(game.turns, it[0].toInt(), it[1].toInt(), "taken", owner) }
+            }
+        }
+        cityOwners = owners
+        lostInBattle.clear()
+        stands[game.turns] = now
+        // The known world's growth, for the ruled civs whose ages are told
+        val seenNow = HashMap<String, IntArray>(); val metNow = HashMap<String, List<String>>()
+        for (civ in game.civilizations.filter { it.civID in com.unciv.logic.automation.RulerOverrides.ruledCivs }) {
+            val bits = java.util.BitSet(game.tileMap.tileList.size)
+            game.tileMap.tileList.forEachIndexed { index, tile -> if (tile.isExplored(civ)) bits.set(index) }
+            explored[civ.civName]?.let { before -> val fresh = bits.clone() as java.util.BitSet; fresh.andNot(before); if (!fresh.isEmpty) seenNow[civ.civName] = fresh.stream().toArray() }
+            explored[civ.civName] = bits
+            val names = civ.getKnownCivs().filter { it.isMajorCiv() || it.isCityState }.map { it.civName }.toSet()
+            known[civ.civName]?.let { before -> (names - before).takeIf { it.isNotEmpty() }?.let { metNow[civ.civName] = it.toList() } }
+            known[civ.civName] = names
+        }
+        if (seenNow.isNotEmpty()) seen[game.turns] = seenNow
+        if (metNow.isNotEmpty()) met[game.turns] = metNow
+        while (stands.size > KEEP_TURNS) stands.pollFirstEntry()
+        marks.removeAll { it.turn < stands.firstKey() }
+        seen.headMap(stands.firstKey(), false).clear(); met.headMap(stands.firstKey(), false).clear()
+    }
+
+    /** One unit's path from [since] to now: a point per turn, standing still left out */
+    fun path(id: Int, since: Int, until: Int = Int.MAX_VALUE): List<Stand> {
+        val path = ArrayList<Stand>()
+        for (turn in stands.subMap(since, true, until, true).values) {
+            val stand = turn[id] ?: continue
+            if (path.lastOrNull()?.let { it.x == stand.x && it.y == stand.y } != true) path += stand
+        }
+        return path
+    }
+
+    /** Where a unit of [owner]'s fell within the turns [from]..[to], if the battle hook saw it fall */
+    fun fallOf(id: Int, owner: String, from: Int, to: Int): Mark? = marks.firstOrNull { it.kind == "fallen" && it.id == id && it.civ == owner && it.turn in from..to }
+
+    /** What a unit was last called anywhere in the trail: its name may be missing from stands kept before names were saved */
+    fun nameOf(id: Int): String = stands.descendingMap().values.firstNotNullOfOrNull { it[id]?.name?.takeIf { name -> name.isNotEmpty() } } ?: ""
+
+    fun clear() { stands.clear(); marks.clear(); cityOwners.clear(); seen.clear(); met.clear(); explored.clear(); known.clear() }
+
+    fun toMap() = mapOf(
+        "stands" to stands.mapKeys { it.key.toString() }.mapValues { turn ->
+            turn.value.mapKeys { it.key.toString() }.mapValues { listOf(it.value.x, it.value.y, it.value.civ, it.value.military, it.value.name) } },
+        "marks" to marks.map { listOf(it.turn, it.x, it.y, it.kind, it.civ, it.id) },
+        "cityOwners" to cityOwners,
+        "seen" to seen.mapKeys { it.key.toString() }.mapValues { turn -> turn.value.mapValues { it.value.toList() } },
+        "met" to met.mapKeys { it.key.toString() }
+    )
+
+    fun load(json: JsonValue?) {
+        clear()
+        json?.get("stands")?.forEach { turn ->
+            stands[turn.name.toInt()] = HashMap(turn.associate { it.name.toInt() to Stand(it.getInt(0), it.getInt(1), it.getString(2), it.getBoolean(3), if (it.size > 4) it.getString(4) else "") })
+        }
+        json?.get("seen")?.forEach { turn -> seen[turn.name.toInt()] = HashMap(turn.associate { it.name to it.asIntArray() }) }
+        json?.get("met")?.forEach { turn -> met[turn.name.toInt()] = HashMap(turn.associate { it.name to it.asStringArray().toList() }) }
+        json?.get("marks")?.forEach { marks += Mark(it.getInt(0), it.getInt(1), it.getInt(2), it.getString(3), it.getString(4), if (it.size > 5) it.getInt(5) else -1) }
+        json?.get("cityOwners")?.forEach { cityOwners[it.name] = it.asString() }
+    }
+
+    companion object { const val KEEP_TURNS = 40 }
+}
diff --git a/desktop/src/com/unciv/app/desktop/ruler/RulerUnits.kt b/desktop/src/com/unciv/app/desktop/ruler/RulerUnits.kt
new file mode 100644
index 0000000..7178f4c
--- /dev/null
+++ b/desktop/src/com/unciv/app/desktop/ruler/RulerUnits.kt
@@ -0,0 +1,824 @@
+package com.unciv.app.desktop.ruler
+
+import com.badlogic.gdx.utils.JsonValue
+import com.unciv.logic.automation.unit.CityLocationTileRanker
+import com.unciv.logic.civilization.Civilization
+import com.unciv.logic.civilization.diplomacy.DiplomacyFlags
+import com.unciv.logic.map.HexMath
+import com.unciv.logic.map.mapunit.MapUnit
+import com.unciv.logic.map.mapunit.movement.UnitMovement
+import com.unciv.logic.map.tile.Tile
+import com.unciv.models.UnitActionType
+import com.unciv.models.UpgradeUnitAction
+import com.unciv.models.ruleset.unique.UniqueType
+import com.unciv.ui.screens.worldscreen.unit.actions.UnitActions
+import com.unciv.ui.screens.worldscreen.unit.actions.UnitActionsUpgrade
+import kotlin.math.roundToInt
+import com.unciv.app.desktop.ruler.Prose.article
+import com.unciv.app.desktop.ruler.Prose.plural
+import com.unciv.logic.automation.RulerOverrides
+
+/**
+ *  A ruler's direct orders to single units. While a unit has an order the automation leaves it alone;
+ *  the order is carried out during the civ's turn via [com.unciv.logic.automation.RulerOverrides.unitHandler].
+ */
+class RulerUnits(private val log: (Civilization, String) -> Unit) {
+
+    /** action: move (then release), settle, fortify/garrison, hold, explore (then release), use (a great person's ability, then release), gift (march onto [to]'s land and give the unit to them) */
+    class Order(val action: String, var x: Int?, var y: Int?, val ability: String? = null, val to: String? = null) {
+        /** The fewest steps left to the target at any turn's start so far, and how many turns running the march has not come nearer than that,
+         *  to notice an order that is going nowhere - standing still or wandering alike */
+        var stepsBest: Int? = null
+        var turnsStuck = 0
+        fun toMap() = mapOf("action" to action, "x" to x, "y" to y, "ability" to ability, "to" to to, "stepsBest" to stepsBest, "turnsStuck" to turnsStuck)
+    }
+
+    /** unit id -> order */
+    val orders = HashMap<Int, Order>()
+
+    /** Set by the host: puts the path to the standing research goals' next goal into the engine's queue, which holds only the path to the first */
+    var researchRefill: (Civilization) -> Unit = {}
+
+    /** Units given away by order since the host last reckoned its losses: gone from our rolls, but neither lost nor disbanded */
+    val given = HashSet<Int>()
+
+    /** Great People and missionaries used up by the ruler's own use order since the host last reckoned its losses: spent by order, not left to the officials */
+    val usedByOrder = HashSet<Int>()
+
+    /** Units ordered re-armed that had spent their movement: re-armed at the start of our next turn, when they have it again (unit id -> the reserve then in force) */
+    private val rearmNext = HashMap<Int, Int>()
+
+    /** Set by the host: a garrison march to this city failed - the city's defender warnings are to show in full again, acknowledged or not */
+    var garrisonMissed: (Civilization, Tile) -> Unit = { _, _ -> }
+
+    /** Garrison marches that failed ("unit id@city position" -> the turn): the way reckoned at the order's giving runs through unknown ground the march
+     *  may find closed, so the same soldier is not sent to the same city again for [GARRISON_RETRY] turns (Grand River's Warrior was sent twice and failed twice, Run 23) */
+    private val garrisonFailed = HashMap<String, Int>()
+
+    /** Forget everything of one game */
+    fun reset() { orders.clear(); released.clear(); given.clear(); usedByOrder.clear(); rearmNext.clear(); landLeft.clear(); stillSince.clear(); garrisonFailed.clear() }
+
+    /** Orders for units that no longer exist (a soldier killed on the march; re-arming keeps a unit's number, so its order stays): forgotten, so a dead man never counts as "on the way" */
+    fun forgetTheDead(game: com.unciv.logic.GameInfo) {
+        val alive = game.civilizations.asSequence().flatMap { it.units.getCivUnits() }.map { it.id }.toHashSet()
+        orders.keys.retainAll(alive); released.retainAll(alive); rearmNext.keys.retainAll(alive)
+        garrisonFailed.values.removeIf { game.turns - it >= GARRISON_RETRY } // old enough to be tried again, so no longer kept
+    }
+
+    /** Did this soldier's garrison march to that city fail within the last [GARRISON_RETRY] turns? The standing garrison order passes it over then */
+    fun failedLately(unit: MapUnit, city: Tile) = garrisonFailed[garrisonKey(unit.id, city)]?.let { unit.civ.gameInfo.turns - it < GARRISON_RETRY } == true
+    private fun garrisonKey(id: Int, city: Tile) = "$id@${cityKey(city)}"
+    private fun cityKey(city: Tile) = "${city.position.x.toInt()},${city.position.y.toInt()}"
+
+    /** The failed garrison march to this city still remembered, for its defender warning: "our Warrior #53, sent to garrison it, could not reach it (turn 56)"; null if none */
+    fun garrisonMiss(civ: Civilization, city: Tile): String? {
+        val (key, turn) = garrisonFailed.entries.filter { it.key.endsWith("@${cityKey(city)}") }.maxByOrNull { it.value }?.let { it.key to it.value } ?: return null
+        val id = key.substringBefore("@").toInt()
+        val name = civ.gameInfo.civilizations.asSequence().flatMap { it.units.getCivUnits() }.firstOrNull { it.id == id }?.name ?: "soldier"
+        return "our $name #$id, sent to garrison it, could not reach it (turn $turn)"
+    }
+
+    private fun noteGarrisonFailure(unit: MapUnit, order: Order, target: Tile) {
+        if (order.action != "garrison") return
+        garrisonFailed[garrisonKey(unit.id, target)] = unit.civ.gameInfo.turns
+        garrisonMissed(unit.civ, target)
+    }
+
+    /** A hold that only ever meant "a Great Person awaits orders" must not bind a soldier: the old name check froze Great War Infantry and Bombers,
+     *  and some of those have since been re-armed under the same id with a plainer name - so the test is the log line the bug wrote, never the name alone. */
+    fun dropMistakenHolds(game: com.unciv.logic.GameInfo, chancery: Collection<List<Map<String, Any?>>>) {
+        val frozenByTheBug = chancery.asSequence().flatten().map { it["text"] as String }
+            .filter { "awaits orders" in it && (it.startsWith("A Great War ") || it.startsWith("A Great Bomber")) }
+            .mapNotNull { Regex("#(\\d+)").find(it)?.groupValues?.get(1)?.toInt() }.toHashSet()
+        orders.entries.removeIf { (id, order) -> order.action == "hold" && id in frozenByTheBug
+            && game.civilizations.asSequence().flatMap { it.units.getCivUnits() }.firstOrNull { it.id == id }?.isGreatPerson() == false }
+    }
+
+    fun load(json: JsonValue?) {
+        orders.clear()
+        json?.forEach { orders[it.name.toInt()] = Order(it.getString("action"), it.get("x")?.takeUnless { v -> v.isNull }?.asInt(), it.get("y")?.takeUnless { v -> v.isNull }?.asInt(), it.get("ability")?.takeUnless { v -> v.isNull }?.asString(), it.getString("to", null)).apply {
+            stepsBest = it.get("stepsBest")?.takeUnless { v -> v.isNull }?.asInt(); turnsStuck = it.getInt("turnsStuck", 0) } }
+    }
+
+    fun toMap() = orders.mapKeys { it.key.toString() }.mapValues { it.value.toMap() }
+
+    /** The rest of what a restart would lose: which Great People were handed to the officials, and how long each unit has stood where it stands */
+    fun stateToMap() = mapOf(
+        "released" to released.toList(),
+        "embarkedSince" to embarkedSince.mapKeys { it.key.toString() },
+        "rearmNext" to rearmNext.mapKeys { it.key.toString() },
+        "garrisonFailed" to garrisonFailed,
+        "stillSince" to stillSince.mapKeys { it.key.toString() }.mapValues { mapOf("spot" to it.value.first, "turn" to it.value.second) })
+
+    fun loadState(json: JsonValue?) {
+        released.clear(); stillSince.clear(); rearmNext.clear(); garrisonFailed.clear()
+        json?.get("released")?.forEach { released += it.asInt() }
+        json?.get("rearmNext")?.forEach { rearmNext[it.name.toInt()] = it.asInt() }
+        json?.get("garrisonFailed")?.forEach { garrisonFailed[it.name] = it.asInt() }
+        embarkedSince.clear(); json?.get("embarkedSince")?.forEach { embarkedSince[it.name.toInt()] = it.asInt() }
+        json?.get("stillSince")?.forEach { stillSince[it.name.toInt()] = Pair(it.getString("spot"), it.getInt("turn")) }
+    }
+
+    /** Called by the automation for every unit of a ruled civ. True = we handled it, leave it alone. */
+    /** Great People the ruler has handed back to the officials */
+    val released = HashSet<Int>()
+
+    /** How many turns a unit has stood on the same tile - reckoned each turn by the host's bookkeeping */
+    private val stillSince = HashMap<Int, Pair<String, Int>>()
+    /** Since which turn each land unit of ours has been at sea, embarked */
+    private val embarkedSince = HashMap<Int, Int>()
+    fun noteStanding(civ: Civilization) {
+        val turn = civ.gameInfo.turns
+        for (unit in civ.units.getCivUnits()) {
+            if (unit.isEmbarked()) embarkedSince.putIfAbsent(unit.id, turn) else embarkedSince.remove(unit.id)
+            val spot = unit.getTile().position.toString()
+            val was = stillSince[unit.id]
+            if (was == null || was.first != spot) stillSince[unit.id] = Pair(spot, turn)
+        }
+        stillSince.keys.retainAll(civ.gameInfo.civilizations.flatMap { c -> c.units.getCivUnits().map { it.id } }.toSet())
+    }
+    /** How many turns, this one counted, a land unit of ours has been at sea */
+    fun turnsAtSea(unit: MapUnit) = embarkedSince[unit.id]?.let { unit.civ.gameInfo.turns - it + 1 } ?: 0
+    fun turnsStill(unit: MapUnit) = stillSince[unit.id]?.let { unit.civ.gameInfo.turns - it.second } ?: 0
