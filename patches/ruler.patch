+        else {
+            g.color = inner
+            if (military) g.fillPolygon(Polygon(intArrayOf((x - 4).toInt(), (x + 4).toInt(), (x + 4).toInt(), x.toInt(), (x - 4).toInt()), intArrayOf((y - 4).toInt(), (y - 4).toInt(), (y + 1).toInt(), (y + 5).toInt(), (y + 1).toInt()), 5))
+            else g.fillOval((x - 3).toInt(), (y - 3).toInt(), 6, 6)
+        }
+        g.color = ink; g.stroke = BasicStroke(if (own) 2f else 1.3f); g.draw(disc)
+    }
+
+    /** Three box blurs, separable: close to a gaussian and fast */
+    private fun blur(source: BufferedImage, radius: Int): BufferedImage {
+        if (radius < 1) return source
+        val size = radius * 2 + 1
+        val weights = FloatArray(size) { 1f / size }
+        val horizontal = java.awt.image.ConvolveOp(java.awt.image.Kernel(size, 1, weights), java.awt.image.ConvolveOp.EDGE_NO_OP, null)
+        val vertical = java.awt.image.ConvolveOp(java.awt.image.Kernel(1, size, weights), java.awt.image.ConvolveOp.EDGE_NO_OP, null)
+        var result = source
+        repeat(3) { result = vertical.filter(horizontal.filter(result, null), null) }
+        return result
+    }
+
+    /** How far a point is inside the known world, from 0 (bare parchment) to 1, by the blurred known-world mask: a fade of most of a tile,
+     *  wide enough that no edge can be read as a shore */
+    private fun knownness(mask: Int): Float {
+        val t = ((mask - 70) / 150f).coerceIn(0f, 1f)
+        return t * t * (3 - 2 * t)
+    }
+
+    private fun mix(under: Int, over: Int, amount: Float): Int {
+        val a = Color(under); val b = Color(over)
+        return Color((a.red + (b.red - a.red) * amount).toInt(), (a.green + (b.green - a.green) * amount).toInt(), (a.blue + (b.blue - a.blue) * amount).toInt()).rgb
+    }
+
+    private fun lighter(rgb: Int): Int {
+        val c = Color(rgb)
+        return Color((c.red + 16).coerceAtMost(255), (c.green + 16).coerceAtMost(255), (c.blue + 12).coerceAtMost(255)).rgb
+    }
+}
diff --git a/desktop/src/com/unciv/app/desktop/ruler/RulerAges.kt b/desktop/src/com/unciv/app/desktop/ruler/RulerAges.kt
