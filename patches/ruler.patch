index 0000000..f256ed9
--- /dev/null
+++ b/desktop/src/com/unciv/app/desktop/ruler/RulerAges.kt
@@ -0,0 +1,194 @@
+package com.unciv.app.desktop.ruler
+
+import com.badlogic.gdx.utils.JsonValue
+import com.unciv.logic.GameInfo
+import com.unciv.logic.automation.RulerOverrides
+import com.unciv.logic.civilization.Civilization
+import com.unciv.logic.map.HexMath
+import com.unciv.logic.map.mapunit.MapUnit
+import com.unciv.logic.map.tile.Tile
+import com.unciv.models.ruleset.unique.UniqueType
+
+/**
+ *  What a realm's people did in an age, reckoned from the trail: where each company marched and fell, what the scouts and ships found,
+ *  whom the realm met. In the world's words, for the advisor's letter and the campaign map - the chancery's ledgers say what the
+ *  officials decided; this says what happened out in the world.
+ */
+class RulerAges(private val trail: RulerTrail, private val yearText: (Int) -> String, private val stillFor: (MapUnit) -> Int) {
+
+    /** A company destroyed by arms three or more ages ahead of its own: one of the world's oddities, kept until the trail forgets its turn */
+    private class Outclassed(val turn: Int, val loser: String, val unit: String, val era: String, val victor: String, val by: String, val byEra: String, val place: String)
+    private val outclassed = ArrayList<Outclassed>()
+
+    /** Called by the battle hook for every unit lost anywhere; [turn] is the turn it belongs to */
+    fun noteLoss(loss: RulerOverrides.UnitLoss, turn: Int) {
+        val enemy = loss.enemy ?: return
+        if (loss.civ.isBarbarian || enemy.isBarbarian) return // modern arms against a barbarian band is routine, not a story
+        // Soldiers destroyed by soldiers: a worker or a general taken is no contest of arms, and a civilian has no age of its own
+        if (loss.captured || !loss.unit.isMilitary()) return
+        val ruleset = loss.civ.gameInfo.ruleset
+        fun eraOf(unitName: String) = ruleset.units[unitName]?.let { unit -> unit.requiredTech?.let { ruleset.technologies[it]?.era() } ?: ruleset.eras.keys.firstOrNull() }
+        val era = eraOf(loss.unit.name) ?: return
+        val by = loss.enemyUnit?.takeIf { ruleset.units[it]?.isMilitary == true } ?: return
+        val byEra = eraOf(by) ?: return // a city's guns are not arms of an age
+        if ((ruleset.eras[byEra]?.eraNumber ?: 0) - (ruleset.eras[era]?.eraNumber ?: 0) < 3) return
+        val city = loss.where.getCity()?.takeIf { loss.where.isCityCenter() }
+        val near = city ?: loss.civ.gameInfo.getCities().minByOrNull { it.getCenterTile().aerialDistanceTo(loss.where) }
+        val place = when { city != null -> "at ${city.name}"; near != null -> "near ${near.name}"; else -> "far from any city" }
+        outclassed += Outclassed(turn, loss.civ.civName, loss.unit.name, era, enemy.civName, by, byEra, place)
+        trail.stands.firstEntry()?.key?.let { oldest -> outclassed.removeAll { it.turn < oldest } }
+    }
+
+    fun clear() = outclassed.clear()
+    fun toMap() = mapOf("outclassed" to outclassed.map { listOf(it.turn, it.loser, it.unit, it.era, it.victor, it.by, it.byEra, it.place) })
+    fun load(json: JsonValue?) {
+        outclassed.clear()
+        json?.get("outclassed")?.forEach { outclassed += Outclassed(it.getInt(0), it.getString(1), it.getString(2), it.getString(3), it.getString(4), it.getString(5), it.getString(6), it.getString(7)) }
+    }
+
+    /** Candidates for the Chronicler's oddity of the age, in the world's words: the world's own (arms of another age, a city passed from hand to hand) and ours ("Our ...").
+     *  Empty most ages; each kind is capped, the strangest first */
+    private fun curiosities(civ: Civilization, from: Int, to: Int, first: Map<Int, RulerTrail.Stand>, last: Map<Int, RulerTrail.Stand>, enemies: Set<String>): List<String> {
+        val game = civ.gameInfo
+        val lines = ArrayList<String>()
+        fun count(n: Int, name: String) = if (n == 1) (if (name.firstOrNull()?.lowercaseChar()?.let { it in "aeiou" } == true) "An $name" else "A $name") else "$n ${name}s"
+        // (a) arms of an older age destroyed by a far newer one - the world's
+        outclassed.filter { it.turn in from..to }.groupBy { listOf(it.loser, it.unit, it.victor, it.by, it.place) }.entries.take(3).forEach { (_, group) ->
+            val o = group[0]
+            lines += "${count(group.size, o.unit)} of ${RulerCampaigns.people(o.loser)}, arms of the ${o.era}, fell to ${RulerCampaigns.possessive(o.victor)} ${o.by}, arms of the ${o.byEra}, ${o.place}."
+        }
+        // (c) a city that changed hands twice or more within the age - the world's
+        trail.marks.filter { it.turn in from..to && it.kind == "taken" }.groupBy { it.x to it.y }.filter { it.value.size >= 2 }.forEach { (xy, marks) ->
+            val city = game.tileMap.getIfTileExistsOrNull(xy.first, xy.second)?.getCity() ?: return@forEach
+            lines += "${city.name} changed hands ${marks.size} times in these years; ${city.civ.civName} holds it now."
+        }
+        // Ours are told in the age they come about, not in every age after: a unit that stays where it is makes no new story
+        val towns = civ.cities.map { it.getCenterTile() }
+        val tileOf = { stand: RulerTrail.Stand? -> stand?.let { game.tileMap.getIfTileExistsOrNull(it.x, it.y) } }
+        // (b) one of ours that went far from every town of ours, or a civilian of ours that went into a foreign city
+        if (towns.isNotEmpty()) {
+            val here = civ.units.getCivUnits().filter { it.id in last && !it.isGreatPerson() }
+            val farOf = { tile: Tile -> towns.minOf { town -> town.aerialDistanceTo(tile) } }
+            here.filter { it.baseUnit.isLandUnit }.map { it to farOf(it.getTile()) }
+                .filter { (unit, distance) -> distance >= 12 && tileOf(first[unit.id])?.let { farOf(it) < 12 } != false }
+                .sortedByDescending { it.second }.take(2)
+                .forEach { (unit, _) -> lines += "Our ${unit.name} reached ${placeOf(civ, unit.getTile(), enemies)}, far from any town of ours." }
+            here.filter { it.isCivilian() && it.getTile().isCityCenter() && it.getTile().getOwner() != civ && tileOf(first[it.id]) != it.getTile() }.take(2)
+                .forEach { unit -> lines += "Our ${unit.name} went into ${unit.getTile().getCity()!!.name}, a city of ${unit.getTile().getOwner()!!.civName}." }
+        }
+        // (d) a Great Person that has now stood still for forty turns, (e) a settler that has now waited thirty - told once, in the age the count was reached
+        val ageLength = to - from
+        for (unit in civ.units.getCivUnits()) {
+            val still = stillFor(unit)
+            if (unit.isGreatPerson() && still >= 40 && still - ageLength < 40) lines += "Our ${unit.name} has stood ${RulerCampaigns.atPlace(placeOf(civ, unit.getTile(), enemies))} since ${yearText(to - still)}."
+            else if (unit.hasUnique(UniqueType.FoundCity) && still >= 30 && still - ageLength < 30) lines += "Our ${unit.name} has waited ${RulerCampaigns.atPlace(placeOf(civ, unit.getTile(), enemies))} since ${yearText(to - still)}."
+        }
+        return lines
+    }
+
+    fun summary(civ: Civilization, from: Int): Map<String, Any?> {
+        val game = civ.gameInfo
+        val to = game.turns
+        val turns = trail.stands.subMap(from, true, to, true)
+        val first = turns.firstEntry()?.value ?: emptyMap<Int, RulerTrail.Stand>()
+        val last = turns.lastEntry()?.value ?: emptyMap<Int, RulerTrail.Stand>()
+        val enemies = RulerCampaigns.enemiesOf(civ)
+
+        // The age's campaigns, as an atlas would draw them: a few forces, each with where it set out, where it was making for and how it ended
+        val campaigns = RulerCampaigns.reckon(trail, civ, from, to)
+        fun entry(c: RulerCampaigns.Campaign) = mapOf("whose" to c.whose, "what" to RulerCampaigns.company(c.members.map { it.name }),
+            "from" to RulerCampaigns.placeOf(civ, c.route.first(), enemies, c.whose), "to" to RulerCampaigns.placeOf(civ, c.route.last(), enemies, c.whose),
+            "outcome" to c.outcome.name.lowercase(), "size" to c.size, "fell" to c.fell, "sea" to c.sea,
+            "told" to RulerCampaigns.told(c, civ, enemies),
+            "fromXY" to c.route.first().position.let { listOf(it.x, it.y) }, "toXY" to c.route.last().position.let { listOf(it.x, it.y) },
+            "route" to c.route.map { listOf(it.position.x, it.position.y) })
+        val marches = campaigns.filter { it.ours }.map(::entry)
+        val theirs = campaigns.filter { !it.ours }.map(::entry)
+        // Losses the campaigns do not already tell: a garrison overrun, a picket caught alone
+        val inCampaigns = campaigns.flatMap { c -> c.members.map { c.whose to it.id } }.toSet()
+        val ours = RulerCampaigns.members(trail, game, civ.civName, from, to)
+        val lost = ours.filter { it.fell && (civ.civName to it.id) !in inCampaigns }.groupBy { placeOf(civ, it.end, enemies) }.entries.sortedByDescending { it.value.size }
+            .map { (place, group) -> mapOf("what" to RulerCampaigns.company(group.map { it.name }), "where" to place, "at" to RulerCampaigns.atPlace(place), "xy" to group[0].end.position.let { listOf(it.x, it.y) }) }
+        val enemyLost = enemies.flatMap { enemy -> RulerCampaigns.members(trail, game, enemy, from, to).filter { it.fell && it.end.isExplored(civ) && (enemy to it.id) !in inCampaigns }.map { enemy to it } }
+            .groupBy { (enemy, member) -> enemy to RulerCampaigns.placeOf(civ, member.end, enemies, enemy) }.entries
+            .map { (key, group) -> mapOf("whose" to key.first, "what" to RulerCampaigns.company(group.map { it.second.name }), "where" to key.second, "at" to RulerCampaigns.atPlace(key.second)) }
+        // Cities that changed hands in the age
+        val taken = trail.marks.filter { it.turn in from..to && it.kind == "taken" }.mapNotNull { mark ->
+            game.tileMap.getIfTileExistsOrNull(mark.x, mark.y)?.getCity()?.let { city -> mapOf("city" to city.name, "by" to mark.civ, "year" to yearText(mark.turn)) } }
+
+        // The known world's growth: what was seen for the first time, in which direction, how far, and what it held
+        val fresh = trail.seen.subMap(from, false, to, true).values.flatMap { it[civ.civName]?.toList() ?: emptyList() }
+            .mapNotNull { game.tileMap.tileList.getOrNull(it) }
+        val capital = civ.getCapital()?.getCenterTile()
+        val exploration = if (fresh.isEmpty()) null else {
+            val land = fresh.count { it.isLand }
+            val direction = capital?.let { compassOf(it, fresh.map { t -> HexMath.hex2WorldCoords(t.position) }.let { pts -> pts.reduce { a, b -> a.add(b) }.scl(1f / pts.size) }, HexMath.hex2WorldCoords(it.position)) }
+            val farthest = capital?.let { c -> fresh.maxOf { it.aerialDistanceTo(c) } }
+            val wonders = fresh.mapNotNull { it.naturalWonder }.distinct()
+            val found = fresh.filter { it.isCityCenter() }.mapNotNull { it.getCity() }
+            mapOf("tilesSeen" to fresh.size, "mostly" to (if (land * 2 >= fresh.size) "land" else "sea"), "direction" to direction, "farthest" to farthest,
+                "naturalWonders" to wonders, "citiesFound" to found.map { "${it.name} (${it.civ.civName})" }, "citiesFoundTold" to RulerCampaigns.citiesOf(found, civ))
+        }
+        val met = trail.met.subMap(from, false, to, true).values.flatMap { it[civ.civName] ?: emptyList() }.distinct()
+        // Our farthest ranging units - the scouts and ships whose journeys the exploration came from
+        val explorers = ours.filter { m -> !m.air && civ.cities.none { it.getCenterTile().aerialDistanceTo(m.end) < 8 } && m.start.aerialDistanceTo(m.end) >= 8 }
+            .sortedByDescending { it.start.aerialDistanceTo(it.end) }.take(3)
+            .map { mapOf("what" to it.name, "reached" to placeOf(civ, it.end, enemies)) }
+
+        // The companies in sight now, as the map's badges show them: none inside a city, which stands for its garrison, and no aircraft
+        // A soldier at sea is embarked, in boats - not standing on the water
+        val inSight = civ.viewableTiles.filter { !it.isCityCenter() }.flatMap { tile -> tile.getUnits().filter { !it.baseUnit.isAirUnit() }.map { tile to it } }
+            .groupBy { (tile, unit) -> Triple(unit.civ.civName, RulerCampaigns.placeOf(civ, tile, enemies, unit.civ.civName), tile.isWater && unit.baseUnit.isLandUnit) }.entries
+            .sortedWith(compareBy({ it.key.first != civ.civName }, { it.key.first }))
+            .map { (key, group) -> mapOf("whose" to key.first, "what" to RulerCampaigns.company(group.map { it.second.name }) + if (key.third) ", embarked in boats" else "",
+                "where" to key.second, "at" to RulerCampaigns.atPlace(key.second), "sea" to group.all { it.second.baseUnit.isWaterUnit }) }
+        // Known country standing apart from the rest of the known world - the lands round a far city heard of - which a painter would otherwise ring with a coast
+        val glimpses = run {
+            val known = game.tileMap.tileList.filter { it.isExplored(civ) }.toHashSet()
+            val reached = HashSet<Tile>(); val names = ArrayList<String>()
+            for (start in known) {
+                if (!reached.add(start)) continue
+                val part = ArrayList<Tile>(); val queue = ArrayDeque(listOf(start))
+                while (queue.isNotEmpty()) { val tile = queue.removeFirst(); part += tile; for (next in tile.neighbors) if (next in known && reached.add(next)) queue += next }
+                if (part.size <= 40 && part.none { it.getOwner() == civ }) names += part.filter { it.isCityCenter() }.mapNotNull { it.getCity()?.name }
+            }
+            names
+        }
+
+        // The same, told
+        val lines = ArrayList<String>()
+        for (m in marches) lines += m["told"] as String
+        for (l in lost) lines += "We lost ${l["what"]} ${l["at"]}."
+        for (t in theirs) lines += t["told"] as String
+        for (l in enemyLost) lines += "${l["whose"]} lost ${l["what"]} ${l["at"]}."
+        // A city taken and taken back is told as one story, ending with who holds it now
+        for (hands in taken.groupBy { it["city"] }.values) {
+            val city = hands[0]["city"]
+            lines += if (hands.size == 1) "$city fell to ${RulerCampaigns.people(hands[0]["by"] as String)} in ${hands[0]["year"]}."
+            else "$city changed hands ${RulerCampaigns.count(hands.size)} times: " + hands.mapIndexed { i, t -> "to ${RulerCampaigns.people(t["by"] as String)}${if (hands.take(i).any { it["by"] == t["by"] }) " again" else ""} in ${t["year"]}" }
+                .let { it.dropLast(1).joinToString(", ") + " and " + it.last() } + "; ${RulerCampaigns.people(hands.last()["by"] as String)} holds it now."
+        }
+        // The known world's growth in words, never a count of tiles: how much, land or water, which way and how far from home
+        if (exploration != null) lines += run {
+            val seen = exploration["tilesSeen"] as Int
+            val found = if (exploration["mostly"] == "sea") (if (seen < 12) "a stretch of new water" else if (seen > 60) "wide new waters" else "new waters")
+                else (if (seen < 12) "a little new country" else if (seen > 60) "wide new country" else "new country")
+            val reach = (exploration["farthest"] as Int?)?.let { if (it <= 6) ", close to home" else if (it <= 12) ", a good way from the capital" else ", far from the capital" } ?: ""
+            "We found $found${exploration["direction"]?.let { " to the $it" } ?: ""}$reach."
+        } +
+            (exploration["naturalWonders"] as List<*>).takeIf { it.isNotEmpty() }?.let { " Found: ${it.joinToString()}." }.orEmpty() +
+            (exploration["citiesFoundTold"] as String).takeIf { it.isNotEmpty() }?.let { " Cities first seen: $it." }.orEmpty()
+        for (e in explorers) lines += "Our ${e["what"]} ranged as far as ${e["reached"]}."
+        if (met.isNotEmpty()) lines += "We met ${met.joinToString { RulerCampaigns.people(it) }}."
+        if (lines.isEmpty()) lines += "No company marched beyond its home fields, nothing new was seen, and no one new was met."
+
+        return mapOf("from" to from, "to" to to, "fromYear" to yearText(from), "toYear" to yearText(to),
+            "marches" to marches, "lost" to lost, "enemyMarches" to theirs, "enemyLost" to enemyLost, "citiesTaken" to taken,
+            "exploration" to exploration, "explorers" to explorers, "met" to met, "inSight" to inSight, "glimpses" to glimpses, "lines" to lines,
+            "curiosities" to curiosities(civ, from, to, first, last, enemies))
+    }
+
+    private fun placeOf(civ: Civilization, tile: Tile, enemies: Set<String>) = RulerCampaigns.placeOf(civ, tile, enemies)
+
+    private fun compassOf(origin: Tile, to: com.badlogic.gdx.math.Vector2, from: com.badlogic.gdx.math.Vector2) = RulerCampaigns.compassOf(to, from)
+}
diff --git a/desktop/src/com/unciv/app/desktop/ruler/RulerCampaigns.kt b/desktop/src/com/unciv/app/desktop/ruler/RulerCampaigns.kt
new file mode 100644
index 0000000..aa2062e
--- /dev/null
+++ b/desktop/src/com/unciv/app/desktop/ruler/RulerCampaigns.kt
@@ -0,0 +1,240 @@
+package com.unciv.app.desktop.ruler
+
+import com.unciv.logic.GameInfo
+import com.unciv.logic.city.City
+import com.unciv.logic.civilization.Civilization
+import com.unciv.logic.map.HexMath
+import com.unciv.logic.map.tile.Tile
+import kotlin.math.atan2
+
+/**
+ *  An age's movements as a history atlas draws them: not every unit's wiggle, but the few forces that went somewhere together -
+ *  where each set out, the way it went, where it was headed and how it ended. The age summary tells these and the campaign map
+ *  draws them, so the words and the arrows cannot disagree.
+ */
+object RulerCampaigns {
+    /** How a force's age ended: it took the city it marched on, was broken (half or more of it fell), turned back, or is still out there */
+    enum class Outcome { Took, Broken, Back, Out }
+
+    /** One unit's age: its path while it was [owner]'s, and the point it was making for - where it ended, fell, or turned back */
+    class Member(val id: Int, val name: String, val path: List<Tile>, val goal: Int, val fell: Boolean, val back: Boolean, val sea: Boolean, val air: Boolean, val scout: Boolean) {
+        val start get() = path.first()
+        val end get() = path.last()
+        val target get() = path[goal]
+        val reach get() = start.aerialDistanceTo(target)
+    }
+
+    class Campaign(val whose: String, val ours: Boolean, val members: List<Member>, val outcome: Outcome, val city: City?, val lostAgain: Boolean,
+                   /** From where the force set out to where it was making for, simplified to a few points */
+                   val route: List<Tile>,
+                   /** A force that turned back: the way home, from its farthest point to where it stands now */
+                   val homeward: List<Tile>) {
+        val sea get() = members.first().sea
+        val size get() = members.size
+        val fell get() = members.count { it.fell }
+        val reach get() = route.first().aerialDistanceTo(route.last())
+    }
+
+    /** Majors at war with [civ] now, or lately: a peace treaty still in force means the war was within the age */
+    fun enemiesOf(civ: Civilization): Set<String> = civ.gameInfo.civilizations.filter { other -> other.isMajorCiv() && other != civ && (civ.isAtWarWith(other) ||
+        civ.getDiplomacyManager(other)?.trades?.any { trade -> (trade.ourOffers + trade.theirOffers).any { it.name == com.unciv.Constants.peaceTreaty } } == true) }
+        .map { it.civName }.toSet()
+
+    /** Every military unit of [owner]'s in the age, with its path while it was theirs. A unit given away within the age is left out:
+     *  the gift is no march of the giver's, and the receiver's march begins at the handing over. An upgrade keeps the unit's id, so its path runs on. */
+    fun members(trail: RulerTrail, game: GameInfo, owner: String, from: Int, to: Int): List<Member> {
+        val turns = trail.stands.subMap(from, true, to, true)
+        val last = turns.lastEntry()?.value ?: emptyMap()
+        val ids = turns.values.flatMap { stands -> stands.filter { it.value.civ == owner && it.value.military }.keys }.toSet()
+        return ids.mapNotNull { id ->
+            val stands = turns.values.mapNotNull { it[id] }
+            if (stands.last().civ != owner) return@mapNotNull null
+            val path = ArrayList<Tile>()
+            for (stand in stands) if (stand.civ == owner) {
+                val tile = game.tileMap.getIfTileExistsOrNull(stand.x, stand.y) ?: continue
+                if (path.lastOrNull() != tile) path += tile
+            }
+            if (path.isEmpty()) return@mapNotNull null
+            // Units lost before names were kept go by what they were: a ship or a soldier
+            val name = stands.lastOrNull { it.name.isNotEmpty() }?.name ?: trail.nameOf(id)
+            val unit = game.ruleset.units[name]
+            val sea = unit?.isWaterUnit ?: path.all { it.isWater }
+            val fell = id !in last && trail.marks.any { it.kind == "fallen" && it.turn in from..to && it.civ == owner && it.x == path.last().position.x && it.y == path.last().position.y }
+            val start = path.first()
+            val far = path.indices.maxBy { start.aerialDistanceTo(path[it]) }
+            // Went out and came home again: what it was making for is the farthest it got, not where it stands now
+            val back = !fell && path[far].aerialDistanceTo(path.last()) >= 3 && start.aerialDistanceTo(path.last()) <= start.aerialDistanceTo(path[far]) - 3
+            Member(id, name.ifEmpty { if (sea) "ship" else "soldier" }, path, if (back) far else path.lastIndex, fell, back, sea, unit?.isAirUnit() == true, unit?.unitType == "Scout")
+        }
+    }
+
+    /** The age's campaigns as [civ] can tell them: at most three of its own and three of the enemy's it could see, the weightiest first */
+    fun reckon(trail: RulerTrail, civ: Civilization, from: Int, to: Int): List<Campaign> {
+        val enemies = enemiesOf(civ)
+        val ours = forces(trail, civ, civ.civName, from, to).take(3)
+        val theirs = enemies.flatMap { forces(trail, civ, it, from, to) }.sortedByDescending { weight(it) }.take(3)
+        return ours + theirs
+    }
+
+    private fun weight(c: Campaign) = c.size * (c.reach + 2) + when (c.outcome) { Outcome.Took -> 30; Outcome.Broken -> 15; else -> 0 }
+
+    private fun cityNear(game: GameInfo, tile: Tile, within: Int) =
+        game.getCities().map { it.getCenterTile() }.filter { it.aerialDistanceTo(tile) <= within }.minByOrNull { it.aerialDistanceTo(tile) }?.getCity()
+
+    private fun forces(trail: RulerTrail, civ: Civilization, owner: String, from: Int, to: Int): List<Campaign> {
+        val game = civ.gameInfo
+        val ours = owner == civ.civName
+        // Aircraft rebase from field to field and missiles fly once: no march of theirs is a campaign; a scout's journey is exploration, told as such.
+        // The enemy's only on ground we know.
+        val movers = members(trail, game, owner, from, to).filter { !it.air && !it.scout && it.reach >= 3 && (ours || it.target.isExplored(civ)) }
+        // Gather into forces: set out from about the same place, making for about the same place or the same city
+        val groups = ArrayList<MutableList<Member>>()
+        for (m in movers.sortedByDescending { it.reach }) {
+            val group = groups.firstOrNull { g -> g[0].sea == m.sea && g[0].start.aerialDistanceTo(m.start) <= 4 &&
+                (g[0].target.aerialDistanceTo(m.target) <= 3 || cityNear(game, g[0].target, 2)?.let { it == cityNear(game, m.target, 2) } == true) }
+            if (group != null) group += m else groups += mutableListOf(m)
+        }
+        val taken = trail.marks.filter { it.kind == "taken" && it.civ == owner && it.turn in from..to }.mapNotNull { game.tileMap.getIfTileExistsOrNull(it.x, it.y) }
+        return groups.map { group ->
+            // The force's way is the way its most typical member went
+            val medoid = group.minBy { m -> group.sumOf { o -> m.start.aerialDistanceTo(o.start) + m.target.aerialDistanceTo(o.target) } }
+            val took = taken.firstOrNull { city -> group.any { it.target.aerialDistanceTo(city) <= 2 } }
+            val outcome = when {
+                took != null -> Outcome.Took
+                group.count { it.fell } * 2 >= group.size -> Outcome.Broken
+                group.count { it.back } * 2 > group.size -> Outcome.Back
+                else -> Outcome.Out
+            }
+            // To the first arrival before the goal: the dithering in front of the walls is no part of the march
+            val arrive = (0..medoid.goal).first { medoid.path[it].aerialDistanceTo(medoid.target) <= 1 }
+            val way = medoid.path.subList(0, arrive + 1).toMutableList()
+            if (way.last() != medoid.target) way += medoid.target
+            if (took != null && way.last() != took) way += took
+            val route = broadWay(way)
+            val homeward = if (outcome == Outcome.Back) broadWay(medoid.path.subList(medoid.goal, medoid.path.size)) else emptyList()
+            val city = took?.getCity() ?: cityNear(game, medoid.target, 2)
+            Campaign(owner, ours, group, outcome, city, took != null && city?.civ?.civName != owner, route, homeward)
+        }.filter { c -> worthAnArrow(game, c, owner) }.sortedByDescending { weight(it) }
+    }
+
+    /** A battle, a city taken, a march on a foe, or a host on the move in a war: soldiers changing garrisons in peace are no campaign,
+     *  nor is an assault from right under the walls - the ring round the city tells that */
+    private fun worthAnArrow(game: GameInfo, c: Campaign, owner: String): Boolean {
+        if (c.reach < 3) return false
+        val foes = game.civilizations.firstOrNull { it.civName == owner }?.let { enemiesOf(it) } ?: emptySet()
+        val onAFoe = game.getCities().any { it.civ.civName in foes && it.getCenterTile().aerialDistanceTo(c.route.last()) <= 3 }
+        return when (c.outcome) {
+            Outcome.Took -> true
+            Outcome.Broken -> c.size >= 2 || c.reach >= 6 // one soldier lost a few tiles out is a skirmish, told among the losses
+            Outcome.Back -> c.fell > 0 || onAFoe
+            Outcome.Out -> c.fell > 0 || (c.size >= 2 && onAFoe) || (foes.isNotEmpty() && c.size >= 3 && c.reach >= 5)
+        }
+    }
+
+    /** The way as an atlas draws it: from start to goal, bending once where a long march went well aside from the straight line - round a sea
+     *  or a range - and not for every zig of a column or jump of a railway. A march of a few tiles goes straight: its turns are tactics, not the way.
+     *  A bend behind the start or beyond the goal is a detour, not the way. */
+    private fun broadWay(path: List<Tile>): List<Tile> {
+        if (path.size <= 2 || path.first().aerialDistanceTo(path.last()) < 6) return listOf(path.first(), path.last())
+        val points = path.map { HexMath.hex2WorldCoords(it.position) }
+        val a = points.first(); val dx = points.last().x - a.x; val dy = points.last().y - a.y
+        val chord = kotlin.math.sqrt(dx * dx + dy * dy).coerceAtLeast(0.001f)
+        var bend = -1; var farthest = maxOf(2.5f * TILE, 0.35f * chord)
+        for (i in 1 until path.lastIndex) {
+            val rx = points[i].x - a.x; val ry = points[i].y - a.y
+            val along = (rx * dx + ry * dy) / (chord * chord)
+            if (along < 0.15f || along > 0.85f) continue
+            val aside = kotlin.math.abs(rx * dy - ry * dx) / chord
+            if (aside > farthest) { bend = i; farthest = aside }
+        }
+        return if (bend < 0) listOf(path.first(), path.last()) else listOf(path.first(), path[bend], path.last())
+    }
+    private val TILE = kotlin.math.sqrt(3f) // neighbouring tiles lie this far apart on the drawn plane
+
+    // Telling
+
+    /** "3 Infantry and a Rocket Artillery" */
+    fun company(names: List<String>): String {
+        val parts = names.groupingBy { it }.eachCount().entries.sortedByDescending { it.value }.map { (name, n) -> if (n == 1) article(name) else "$n ${plural(name)}" }
+        return if (parts.size <= 1) parts.joinToString() else parts.dropLast(1).joinToString(", ") + " and " + parts.last()
+    }
+    private fun article(name: String) = if (name.firstOrNull()?.lowercaseChar()?.let { it in "aeiou" } == true) "an $name" else "a $name"
+    private fun plural(name: String) = when {
+        name.endsWith("man") -> name.dropLast(3) + "men"
+        name.endsWith("s") || Regex("(Infantry|Artillery|Cavalry)$").containsMatchIn(name) -> name
+        name.endsWith("y") && name.getOrNull(name.length - 2)?.let { it !in "aeiou" } == true -> name.dropLast(1) + "ies"
+        else -> name + "s"
+    }
+
+    fun count(n: Int) = listOf("no", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven", "twelve").getOrNull(n) ?: "$n"
+
+    /** The campaign in one sentence of the world's words, as [civ] tells it */
+    fun told(c: Campaign, civ: Civilization, enemies: Set<String>): String {
+        val what = company(c.members.map { it.name }).replaceFirstChar { it.uppercase() }
+        val who = if (c.ours) what else "$what of ${people(c.whose)}"
+        val verb = if (c.sea) "sailed" else if (c.ours) "marched" else "came"
+        val from = placeOf(civ, c.route.first(), enemies, c.whose)
+        val to = placeOf(civ, c.route.last(), enemies, c.whose)
+        val fell = when {
+            c.fell == 0 -> ""
+            c.size == 1 -> "it fell"
+            c.fell == c.size -> if (c.size == 2) "both fell" else "all fell"
+            else -> "${count(c.fell)} of the ${count(c.size)} fell"
+        }
+        return when (c.outcome) {
+            Outcome.Took -> if (c.fell == c.size) "$who $verb from $from to $to, where $fell as the city was taken${if (c.lostAgain) ", though it was lost again" else ""}."
+                else "$who $verb from $from to $to and took it${if (c.lostAgain) ", but lost it again" else ""}${if (fell.isEmpty()) "" else "; $fell"}."
+            Outcome.Broken -> "$who $verb from $from to $to, where $fell."
+            Outcome.Back -> "$who went from $from as far as $to and turned back${if (fell.isEmpty()) "" else "; $fell"}."
+            Outcome.Out -> "$who $verb from $from to $to${if (fell.isEmpty()) "" else "; $fell"}."
+        }
+    }
+
+    /** A place as a chronicle names it: a city, its fields, or a distance and direction from the nearest city we know.
+     *  "The walls of" a city are the walls of a foe's: of our enemy's for our own companies, of ours for the enemy's ([mover] is whose company stands there) */
+    fun placeOf(civ: Civilization, tile: Tile, enemies: Set<String>, mover: String = civ.civName): String {
+        val city = tile.getCity()
+        if (city != null && tile.isCityCenter()) return named(city, civ, mover)
+        val near = civ.gameInfo.getCities().filter { it.getCenterTile().isExplored(civ) }.minByOrNull { it.getCenterTile().aerialDistanceTo(tile) } ?: return "far from any city"
+        val distance = near.getCenterTile().aerialDistanceTo(tile)
+        val foes = if (mover == civ.civName) near.civ.civName in enemies else near.civ == civ
+        return when {
+            distance <= 1 && foes -> "the walls of ${named(near, civ, mover)}"
+            distance <= 2 -> "the fields of ${named(near, civ, mover)}"
+            // Beyond a city's fields, the country or the waters that way, and distant ones well beyond; never a count of tiles
+            else -> "the ${if (distance > 5) "distant " else ""}${if (tile.isWater) "waters" else "country"} ${compassOf(HexMath.hex2WorldCoords(tile.position), HexMath.hex2WorldCoords(near.getCenterTile().position))} of ${named(near, civ, mover)}"
+        }
+    }
+
+    /** A city as [civ] names it, whose it is said in words and never in brackets: "Seoul", "Ethiopia's Axum". Our own cities, the [mover]'s own
+     *  (the company's whose it is, already named) and a city-state named for its city go by the city's name alone */
+    fun named(city: City, civ: Civilization, mover: String = civ.civName) =
+        if (city.civ == civ || city.civ.civName == mover || city.civ.civName == city.name) city.name else "${possessive(city.civ.civName)} ${city.name}"
+
+    /** A people's name within a sentence: "the Maya", "Ethiopia" */
+    fun people(civName: String) = civName.replaceFirst(Regex("^The "), "the ")
+
+    /** "Ethiopia's", "the Maya's", "the Netherlands'" - for use within a sentence */
+    fun possessive(civName: String): String {
+        val name = people(civName)
+        return if (name.endsWith("s")) "$name'" else "$name's"
+    }
+
+    /** Cities by whose they are: "Axum and Addis Ababa of Ethiopia; Carthage" - a city-state named for its city stands alone */
+    fun citiesOf(cities: List<City>, civ: Civilization): String = cities.groupBy { it.civ }.entries.joinToString("; ") { (owner, group) ->
+        val names = group.map { it.name }.let { if (it.size == 1) it[0] else it.dropLast(1).joinToString(", ") + " and " + it.last() }
+        if (owner == civ || group.all { it.name == owner.civName }) names else "$names of ${people(owner.civName)}"
+    }
+
+    /** A [placeOf] place with the word before it: at a city, its walls or its fields; in the country or waters beyond */
+    fun atPlace(place: String) = when {
+        place.startsWith("far ") -> place
+        Regex("^the (distant )?(country|waters) ").containsMatchIn(place) -> "in $place"
+        else -> "at $place"
+    }
+
+    fun compassOf(to: com.badlogic.gdx.math.Vector2, from: com.badlogic.gdx.math.Vector2): String {
+        val angle = Math.toDegrees(atan2((to.y - from.y).toDouble(), (to.x - from.x).toDouble()))
+        return listOf("east", "north-east", "north", "north-west", "west", "south-west", "south", "south-east")[(((angle + 360 + 22.5) % 360) / 45).toInt()]
+    }
+}
