+                "${if (holder.isCityState) "the city-state of ${holder.civName}" else name(holder)}: ${held.size} of the $majors original capitals - " + andList(held.map { city ->
+                    city.name + (if (city.foundingCivObject != holder) " (${city.foundingCivObject!!.civName}'s)" else "") +
+                        (if (holder != civ && city.getCenterTile().getContinent() !in ourLands) ", across the sea from us" else "") })
+            } + listOfNotNull((majors - capitals.size).takeIf { it > 0 }?.let { "$it original capital${plural(it)} we have never seen" })
+        }
+        if (unmet > 0) race["powers we have not met"] = listOf("$unmet great power${plural(unmet)} we have not met: their standing is unknown to us")
+        return race
+    }
+
+    /** The branches of policy shut to us for good - their opening policy unavailable to us now that another is ours - and whether the cultural road is shut */
+    private fun shutBranches(civ: Civilization): String? {
+        val needed = culturalBranchesNeeded(civ) ?: return null
+        val branches = civ.gameInfo.ruleset.policyBranches.values
+        // Shut for good: "Only available <before adopting [Rationalism]>" with Rationalism ours (Piety), or unavailable outright
+        val shut = branches.filter { branch -> !civ.policies.isAdopted(branch.name) && (branch.hasUnique(com.unciv.models.ruleset.unique.UniqueType.Unavailable, civ.state) ||
+            branch.getMatchingUniques(com.unciv.models.ruleset.unique.UniqueType.OnlyAvailable, com.unciv.models.ruleset.unique.GameContext.IgnoreConditionals).any { only ->
+                only.modifiers.any { it.type == com.unciv.models.ruleset.unique.UniqueType.ConditionalBeforePolicyOrBelief && civ.policies.isAdopted(it.params[0]) } }) }
+        if (shut.isEmpty()) return null
+        val open = branches.size - shut.size
+        return "shut to us for good: ${andList(shut.map { it.name })}" + (if (open < needed) " - fewer than $needed branches are left open to us, so the cultural road is shut" else "")
+    }
+
+    /** Each branch of policy we have opened: (branch, policies of it adopted, policies in it), the opening one counted */
+    private fun ourBranches(civ: Civilization) = civ.gameInfo.ruleset.policyBranches.values.filter { civ.policies.isAdopted(it.name) }.map { branch ->
+        val members = branch.policies.filter { it.policyBranchType == com.unciv.models.ruleset.Policy.PolicyBranchType.Member }
+        Triple(branch, 1 + members.count { civ.policies.isAdopted(it.name) }, 1 + members.size) }
+
+    /** The ways this game can be won, as its own settings have them - a game may have been set to fewer than all */
+    private fun victoriesInPlay(civ: Civilization): String {
+        val types = civ.gameInfo.gameParameters.victoryTypes.filter { it in civ.gameInfo.ruleset.victories }
+        if (types.isEmpty()) return "No victory is in play in this game."
+        val how = types.map { type -> when (type) {
+            "Scientific" -> "a scientific victory, the turn the last spaceship part is added to the ship in the capital"
+            "Domination" -> "a domination victory, by holding every other great power's original capital"
+            "Cultural" -> "a cultural victory, by completing five branches of policy and building the Utopia Project"
+            "Diplomatic" -> "a diplomatic victory, by being voted world leader once the United Nations stands"
+            else -> "a ${type.lowercase()} victory" } }
+        return "This game can be won only by " + (if (how.size == 1) how.single() else how.dropLast(1).joinToString("; ") + "; or " + how.last()) + "."
+    }
+
+    /** A place as a chancery line names it, with its preposition: "at the fields of Ecbatana", "in the country south of Persepolis" - never a count of tiles, which the ruler must not read */
+
+    /** A city's place in the world as a painter needs it: "on the coast, among forests, grassland country" */
+    private fun lieOfTheLand(city: com.unciv.logic.city.City): String {
+        val centre = city.getCenterTile()
+        return listOfNotNull(
+            if (city.isCoastal()) "on the coast" else null,
+            if (centre.isAdjacentToRiver()) "by a river" else null,
+            if (centre.isHill()) "on a hill" else null,
+            centre.getTilesInDistance(RulerOverrides.FIELDS).count { it.terrainFeatures.contains("Forest") }.takeIf { it >= 3 }?.let { "among forests" },
+            centre.getTilesInDistance(RulerOverrides.FIELDS).any { it.baseTerrain == "Mountain" }.takeIf { it }?.let { "under mountains" },
+            centre.baseTerrain.lowercase().takeIf { it in listOf("desert", "tundra", "snow", "plains", "grassland") }?.let { "$it country" }).joinToString(", ").ifEmpty { "inland" }
+    }
+
+    private class WorldSnapshot(game: GameInfo) {
+        val wars = HashSet<Set<String>>()
+        val cityOwners = HashMap<String, String>()
+        val capitals = HashSet<String>()
+        val wonders = HashMap<String, String>()
+        /** wonder -> the city it stands in, and the lie of the land there */
+        val wonderSites = HashMap<String, String>()
+        val eras = HashMap<String, String>()
+        val alive = HashSet<String>()
+        init {
+            for (civ in game.civilizations) {
+                if (civ.isBarbarian || civ.isSpectator()) continue
+                if (civ.isAlive()) alive += civ.civName
+                if (civ.isMajorCiv()) eras[civ.civName] = civ.getEra().name
+                for (city in civ.cities) {
+                    cityOwners[city.name] = civ.civName
+                    if (city.isCapital()) capitals += city.name
+                    for (building in city.cityConstructions.getBuiltBuildings())
+                        if (building.isWonder) {
+                            wonders[building.name] = civ.civName
+                            wonderSites[building.name] = "${city.name} (${if (city.isCapital()) "the capital, " else ""}${lieOfTheLand(city)})"
+                        }
+                }
+                for (diplomacy in civ.diplomacy.values)
+                    if (diplomacy.diplomaticStatus == DiplomaticStatus.War && !diplomacy.otherCiv.isBarbarian)
+                        wars += setOf(civ.civName, diplomacy.otherCivName)
+            }
+        }
+    }
+
+    /** The world's news of the turn being played, with its facts (RulerOverrides.News): the world's events and each chancery read it, and it is
+     *  forgotten once they have. What an order did between turns (a pact signed, a denouncement) is told with the next turn */
+    private val turnNews = java.util.concurrent.CopyOnWriteArrayList<RulerOverrides.News>()
+    /** Cities a nuclear blow razed this turn: its own event tells them, the city-destroyed event does not tell them again */
+    private val nukeRazed = HashSet<String>()
+
+    /** Where each ruled realm's host at sea is bound, as the last bookkeeping found it: one line per landing, shown with the posture */
+    private val hostAtSea = HashMap<String, List<String>>()
+    /** What each realm's host at sea was doing last turn, by "mode|city": each begins to be told once (a hold, a gathering, a landing under the guns) */
+    private val holdingTold = HashMap<String, Set<String>>()
+    private fun noteHostAtSea(civ: Civilization) {
+        val all = RulerOverrides.landings.remove(civ.civID).orEmpty().mapNotNull { (id, plan) -> civ.units.getUnitById(id)?.let { it to plan } }
+        val plans = all.filter { it.first.isEmbarked() }
+        val cityOf = { plan: RulerOverrides.Landing -> plan.city.getCity()?.name ?: "the enemy" }
+        // Who covers the shores, in words: "the guns of Osaka and Japan's 2 Frigates"
+        val covered = { cover: List<String> ->
+            val guns = cover.filter { it.startsWith("city:") }.map { "the guns of ${it.removePrefix("city:")}" }
+            val arms = cover.filter { it.startsWith("unit:") }.map { it.split(":") }.groupBy { it[1] }
+                .map { (owner, units) -> "${RulerCampaigns.possessive(owner)} " + andList(units.map { it[2] }.groupingBy { it }.eachCount().map { (name, n) -> if (n == 1) name else "$n ${Prose.pluralOf(name)}" }) }
+            andList(guns + arms).ifEmpty { "the enemy's guns" }
+        }
+        hostAtSea[civ.civName] = plans.groupBy { (_, plan) -> Triple(plan.landing, cityOf(plan), plan.mode) }.map { (key, group) ->
+            val (landing, city, mode) = key
+            val longest = group.maxOf { units.turnsAtSea(it.first) }
+            val place = landing?.let { RulerCampaigns.placeOf(civ, it) }
+            RulerCampaigns.company(group.map { it.first.name }).replaceFirstChar { it.uppercase() } + when {
+                place == null -> " holding at sea out of reach: no shore near $city leads to it by land"
+                mode == "waiting" -> " waiting out of reach off $place, against $city: every shore near it lies under ${covered(group[0].second.cover)}" +
+                    " - ships to clear that shore, or a weaker aim, would open a landing"
+                else -> " crossing to ${if (group.size == 1) "its" else "their"} landing at $place, against $city"
+            } + " (${RulerCampaigns.count(longest)} turn${Prose.plural(longest)} at sea)"
+        }
+        // Each begins to be told once: a host waiting off a shore under the guns, or holding with none to land on
+        val now = plans.filter { it.second.mode != "crossing" }.groupBy { "${it.second.mode}|${cityOf(it.second)}" }
+        for ((what, group) in now) {
+            if (what in (holdingTold[civ.civName] ?: emptySet())) continue
+            val plan = group[0].second
+            val city = cityOf(plan)
+            log(civ, if (plan.mode == "waiting") "Our host waits out of reach off ${plan.landing?.let { RulerCampaigns.placeOf(civ, it) }}: no shore near $city lies out of reach of " +
+                    "${covered(plan.cover)}, and it will not land under them. Ships to clear that shore, or a weaker aim, would open a landing."
+                else "Our host holds at sea out of reach: no shore near $city leads to the city by land.")
+        }
+        holdingTold[civ.civName] = now.keys
+    }
